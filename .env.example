PORT=5000
NODE_ENV=development

# SQLite file path (created automatically if missing)
DATABASE_FILE=./data/hipkids.db

# Comma separated list of allowed origins, e.g. http://localhost:5173,https://hipkids.pk
CORS_ORIGIN=http://localhost:5173

# Sent as the "x-admin-key" header to access admin-only endpoints
ADMIN_API_KEY=change-this-admin-key

# Checkout rules
FREE_SHIPPING_THRESHOLD=3500
SHIPPING_FEE=200
