{
  "name": "hipkids-backend",
  "version": "1.0.0",
  "description": "Lightweight REST API for a kids' clothing and footwear storefront",
  "type": "module",
  "private": true,
  "main": "src/server.js",
  "scripts": {
    "dev": "nodemon src/server.js",
    "dev:backend": "nodemon src/server.js",
    "dev:frontend": "npm --prefix frontend run dev",
    "dev:all": "concurrently \"npm run dev:backend\" \"npm run dev:frontend\"",
    "build": "npm run build --prefix frontend",
    "start": "node src/server.js",
    "migrate": "node src/db/migrate.js",
    "seed": "node src/db/seed.js",
    "setup": "npm run migrate && npm run seed",
    "install:all": "npm install && npm --prefix frontend install"
  },
  "dependencies": {
    "cors": "^2.8.5",
    "dotenv": "^16.4.5",
    "express": "^4.21.0",
    "helmet": "^7.1.0",
    "morgan": "^1.10.0",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "concurrently": "^10.0.5",
    "nodemon": "^3.1.7"
  },
  "engines": {
    "node": ">=18"
  }
}
